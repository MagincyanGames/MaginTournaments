{
  "name": "magin-tournaments",
  "private": true,
  "scripts": {
    "dev:back": "cd ./apps/backend && pnpm start:dev",
    "dev:front": "cd ./apps/frontend && pnpm dev",
    "dev": "concurrently -n \"BACK,FRONT\" -c \"magenta,cyan\" \"pnpm dev:back\" \"pnpm dev:front\"",
    "build:wsob-react": "cd ./packages/wsob-react/ && pnpm build",
    "build:wsob-nestjs": "cd ./packages/wsob-nestjs/ && pnpm build",
    "build:wsob": "pnpm build:wsob-react && pnpm build:wsob-nestjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
